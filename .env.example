# Images (arm64 host)
IGNITE2_IMAGE=apacheignite/ignite:2.18.0-arm64
IGNITE3_IMAGE=apacheignite/ignite:3.1.0

# Heap per node
IGNITE_HEAP=1g

# Shared external Docker network
IGNITE_LAB_NETWORK=ignite-lab

# Built-in username used by the lab bootstrap scripts; keep this as "ignite"
IGNITE_LAB_USER=ignite

# Ignite 3 password set by scripts/ignite3-init.sh
IGNITE_LAB_PASSWORD=ignite-lab-pass

# Ignite 2 starts with ignite/ignite. Change this only after manually changing
# that user's password in the cluster.
IGNITE2_PASSWORD=ignite

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
